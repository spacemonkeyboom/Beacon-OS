name			qt5_base_devel
version			5.15.19-1
architecture	riscv64
summary			"Development files for qt5_base (riscv64)"
description		"Headers, link symlinks, pkg-config, CMake and qmake files for Qt 5.15.19 qtbase as cross-built for riscv64 by the Beacon project. The host tools (qmake, moc, rcc, uic) are not included; this build is for cross-compiling."
packager		"Beacon <https://github.com/spacemonkeyboom/Beacon-OS>"
vendor			"Beacon"
copyrights		{ "2015-2020 The Qt Company Ltd." }
licenses		{ "GNU LGPL v3" "GNU GPL v2" }
urls			{ "https://www.qt.io/" "https://github.com/spacemonkeyboom/Beacon-OS" }
provides {
	qt5_base_devel = 5.15.19 compat >= 5
	devel:libQt5Concurrent = 5.15.19 compat >= 5
	devel:libQt5Core = 5.15.19 compat >= 5
	devel:libQt5Gui = 5.15.19 compat >= 5
	devel:libQt5Network = 5.15.19 compat >= 5
	devel:libQt5PrintSupport = 5.15.19 compat >= 5
	devel:libQt5Sql = 5.15.19 compat >= 5
	devel:libQt5Test = 5.15.19 compat >= 5
	devel:libQt5Widgets = 5.15.19 compat >= 5
	devel:libQt5Xml = 5.15.19 compat >= 5
}
requires {
	qt5_base == 5.15.19-1 base
	devel:libcrypto >= 3
	devel:libssl >= 3
}
conflicts {
	qt5_devel
}
