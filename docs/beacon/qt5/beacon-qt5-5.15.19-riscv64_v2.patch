Beacon patch for Qt 5.15.19 on Haiku riscv64 (cross-build), v2: qthaikuplugins also builds with OpenGL.
Part 1 applies to qtbase (KDE commit fbed962c3195ab3952fa54d40e012ad1a4fdc42b) after the
HaikuPorts qtbase-5.15.19.patchset; part 2 applies to qthaikuplugins 8af8224255962a707d8c6d87d8f5082824b1d819.
Apply with "patch -p1" from the directory that holds qtbase/ and qthaikuplugins/.

diff --git a/qtbase/mkspecs/haiku-riscv64-cross-g++/qmake.conf b/qtbase/mkspecs/haiku-riscv64-cross-g++/qmake.conf
new file mode 100644
index 00000000..2fd48234
--- /dev/null
+++ b/qtbase/mkspecs/haiku-riscv64-cross-g++/qmake.conf
@@ -0,0 +1,38 @@
+#
+# qmake configuration for cross-compiling to Haiku riscv64 (Beacon)
+# with Haiku's riscv64-unknown-haiku- cross tools (gcc 13). Use with
+# -xplatform haiku-riscv64-cross-g++ -sysroot <Haiku sysroot>.
+#
+
+MAKEFILE_GENERATOR      = UNIX
+QMAKE_PLATFORM          = haiku
+
+include(../common/unix.conf)
+
+# Beacon: the cross gcc spec links only static libgcc; C++ exception
+# unwinding (_Unwind_Resume) lives in libgcc_s, as on native Haiku.
+QMAKE_LIBS              = -lgcc_s
+QMAKE_INCDIR            =
+QMAKE_LIBDIR            =
+QMAKE_LIBS_NETWORK      = -lnetwork
+QMAKE_LIBS_OPENGL       = -lGL
+QMAKE_LIBS_OPENGL_QT    = -lGL
+
+include(../common/gcc-base-unix.conf)
+include(../common/g++-unix.conf)
+
+isEmpty(CROSS_COMPILE): CROSS_COMPILE = riscv64-unknown-haiku-
+
+QMAKE_CC                = $${CROSS_COMPILE}gcc
+QMAKE_CXX               = $${CROSS_COMPILE}g++
+QMAKE_LINK              = $${CROSS_COMPILE}g++
+QMAKE_LINK_SHLIB        = $${CROSS_COMPILE}g++
+QMAKE_LINK_C            = $${CROSS_COMPILE}gcc
+QMAKE_LINK_C_SHLIB      = $${CROSS_COMPILE}gcc
+QMAKE_AR                = $${CROSS_COMPILE}ar cqs
+QMAKE_OBJCOPY           = $${CROSS_COMPILE}objcopy
+QMAKE_NM                = $${CROSS_COMPILE}nm -P
+QMAKE_STRIP             = $${CROSS_COMPILE}strip
+QMAKE_RANLIB            =
+
+load(qt_config)
