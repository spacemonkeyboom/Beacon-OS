diff --git a/qtbase/src/corelib/corelib.pro b/qtbase/src/corelib/corelib.pro
index 22e37486..c64ce7f1 100644
--- a/qtbase/src/corelib/corelib.pro
+++ b/qtbase/src/corelib/corelib.pro
@@ -78,6 +78,11 @@ integrity {
     LIBS_PRIVATE += -lposix -livfs -lsocket -lnet -lshm_client
 }
 
+# Beacon: qlogging.cpp uses backtrace() when <execinfo.h> exists; on
+# Haiku that comes from the libexecinfo package.
+haiku:exists($$[QT_SYSROOT]/boot/system/develop/headers/execinfo.h): \
+    LIBS_PRIVATE += -lexecinfo
+
 QMAKE_DYNAMIC_LIST_FILE = $$PWD/QtCore.dynlist
 
 HOST_BINS = $$[QT_HOST_BINS]
