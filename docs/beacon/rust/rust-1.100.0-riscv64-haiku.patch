+// Beacon: 64-bit RISC-V Haiku (the Beacon OS riscv64 port).
+use crate::spec::{Arch, CodeModel, LlvmAbi, Target, TargetMetadata, base};
+
+pub(crate) fn target() -> Target {
+    let mut base = base::haiku::opts();
+    base.code_model = Some(CodeModel::Medium);
+    base.cpu = "generic-rv64".into();
+    base.features = "+m,+a,+f,+d,+c,+zicsr,+zifencei".into();
+    base.llvm_abiname = LlvmAbi::Lp64d;
+    base.max_atomic_width = Some(64);
+    base.plt_by_default = false;
+    // Haiku executables are position independent (as on x86_64)
+    base.position_independent_executables = true;
+
+    Target {
+        llvm_target: "riscv64-unknown-haiku".into(),
+        metadata: TargetMetadata {
+            description: Some("64-bit RISC-V Haiku".into()),
+            tier: Some(3),
+            host_tools: Some(false),
+            std: Some(true),
+        },
+        pointer_width: 64,
+        data_layout: "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128".into(),
+        arch: Arch::RiscV64,
+        options: base,
+    }
+}
