{
  "arch": "riscv64",
  "code-model": "medium",
  "cpu": "generic-rv64",
  "crt-objects-fallback": "false",
  "data-layout": "e-m:e-p:64:64-i64:64-i128:128-n32:64-S128",
  "default-uwtable": true,
  "dynamic-linking": true,
  "features": "+m,+a,+f,+d,+c,+zicsr,+zifencei",
  "linker-flavor": "gnu-cc",
  "linker": "riscv64-unknown-haiku-gcc",
  "llvm-abiname": "lp64d",
  "llvm-target": "riscv64-unknown-haiku",
  "max-atomic-width": 64,
  "metadata": {
    "description": "64-bit RISC-V Haiku (Beacon)",
    "host_tools": false,
    "std": true,
    "tier": 3
  },
  "os": "haiku",
  "plt-by-default": false,
  "position-independent-executables": true,
  "relro-level": "full",
  "target-family": ["unix"],
  "target-pointer-width": 64
}
